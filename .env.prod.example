# Production env vars — these go in APP_SECRETS (GitHub environment secret).
# CI validates them against AppConfig on every deploy.

# ── Required ──────────────────────────────────────────────────────────
DOMAIN=dev.agentobox.com                      # Used by docker-compose.prod.yml
SECRET_KEY=generate-a-random-64-char-string   # Django signing key
DATABASE_URL=postgres://agentobox:PASSWORD@HOST:5432/agentobox
ABOX_ENCRYPTION_KEY=                          # Fernet key (see .env.example)

# ── Image versions (set by CI or manually) ────────────────────────────
VERSION=latest
AGENT_VERSION=latest

# ── Modal (agent compute) ─────────────────────────────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main

# ── OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Media (optional) ─────────────────────────────────────────────────
MEDIA_BUCKET=agentobox-media
MEDIA_CDN_URL=
