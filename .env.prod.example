# Domain
DOMAIN=dev.agentobox.com

# Image versions (set by CI or manually)
VERSION=latest
AGENT_VERSION=latest

# Database (external — RDS, Neon, etc.)
DATABASE_URL=postgres://agentobox:PASSWORD@HOST:5432/agentobox

# Security
SECRET_KEY=generate-a-random-64-char-string
ABOX_ENCRYPTION_KEY=generate-a-random-key

# Agent runtime (docker or modal)
AGENT_RUNTIME=modal

# Modal (agent compute)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main

# AWS (S3 for media uploads)
MEDIA_BUCKET=agentobox-media
MEDIA_CDN_URL=
