# Django
SECRET_KEY=
DEBUG=false
DATABASE_URL=postgres://user:pass@host:5432/agentobox
ALLOWED_HOSTS=localhost,agentobox.example.com

# Channels (GraphQL subscriptions)
REDIS_URL=redis://localhost:6379/0

# Runtime
AGENT_RUNTIME=modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Agent defaults
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Webhook security
WEBHOOK_SECRET=

# Observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Docker runtime
AGENT_IMAGE=agentobox-agent:latest
DOCKER_NETWORK=agentobox_default

# Callback / Dashboard (reachable from Modal/Docker containers)
ABOX_CALLBACK_URL=https://agentobox.example.com
ABOX_DASHBOARD_URL=https://agentobox.example.com
