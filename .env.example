# ── Required ──────────────────────────────────────────────────────────
SECRET_KEY=                    # Django signing key (min 50 chars, random)
DATABASE_URL=postgres://user:pass@host:5432/agentobox

# ── Django ────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_HOSTS=localhost,agentobox.example.com
REDIS_URL=redis://localhost:6379/0

# ── Agent runtime ─────────────────────────────────────────────────────
AGENT_RUNTIME=modal            # "modal" (prod) or "docker" (local dev)
AGENT_IMAGE=agentobox-agent-runtime-desktop-managed:dev   # tag must match what CI pushed
DOCKER_NETWORK=agentobox_default
KEEP_FAILED_AGENT_CONTAINERS=false  # set true in local debugging to retain crashed Docker agents
AGENT_REAP_DELAY_S=60

# ── Modal (required if AGENT_RUNTIME=modal) ───────────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_AGENT_IMAGE=ghcr.io/veyorokon/agentobox-agent-runtime-desktop-managed:dev  # tag must match branch

# ── Callback / Dashboard ─────────────────────────────────────────────
ABOX_CALLBACK_URL=https://agentobox.example.com
ABOX_DASHBOARD_URL=https://agentobox.example.com

# ── Encryption ────────────────────────────────────────────────────────
ABOX_ENCRYPTION_KEY=           # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── OAuth (optional — leave empty to disable) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Media (optional) ─────────────────────────────────────────────────
MEDIA_BUCKET=agentobox-media
MEDIA_CDN_URL=
