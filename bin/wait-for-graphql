#!/usr/bin/env bash
# wait-for-graphql — poll a GraphQL endpoint until it responds.
#
# Used by: .github/workflows/deploy-dev.yml, promote-prod.yml
# Contract: polls endpoint up to $2 times (default 30), $3 seconds apart (default 5).
#
# Usage: wait-for-graphql <domain> [max_attempts] [interval_seconds]

set -euo pipefail

domain="${1:?Usage: wait-for-graphql <domain> [max_attempts] [interval]}"
max_attempts="${2:-30}"
interval="${3:-5}"
url="https://${domain}/graphql"

for i in $(seq 1 "$max_attempts"); do
  if curl -sf "$url" -H 'Content-Type: application/json' -d '{"query":"{ __typename }"}' > /dev/null 2>&1; then
    echo "Backend ready after attempt $i"
    exit 0
  fi
  echo "  Waiting for backend... attempt $i/$max_attempts"
  sleep "$interval"
done

echo "::error::Backend did not respond after $max_attempts attempts"
exit 1
