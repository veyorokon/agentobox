#!/usr/bin/env python3
"""validate-app-config — validate and export APP_CONFIG + APP_SECRETS.

Used by: .github/workflows/deploy-dev.yml, promote-prod.yml
Contract: reads _APP_CONFIG and _APP_SECRETS from environment variables,
          validates required keys, prints shell export statements to stdout.

Usage:
    eval "$(python3 bin/validate-app-config)"

Callers must set _APP_CONFIG and _APP_SECRETS as env vars before invoking.
This avoids shell-quoting fragility from passing raw JSON as CLI args.
"""

import json
import os
import sys

REQUIRED_KEYS = ["DOMAIN"]


def main():
    merged = {}

    for label, env_key in [("APP_CONFIG", "_APP_CONFIG"), ("APP_SECRETS", "_APP_SECRETS")]:
        raw = os.environ.get(env_key, "").strip()
        if raw:
            try:
                merged.update(json.loads(raw))
            except json.JSONDecodeError:
                print(f"echo 'ERROR: {label} is not valid JSON'; exit 1")
                sys.exit(0)

    for key in REQUIRED_KEYS:
        if key not in merged:
            print(f"echo 'ERROR: {key} missing from APP_CONFIG'; exit 1")
            sys.exit(0)

    for k, v in merged.items():
        safe = v.replace("'", "'\\''")
        print(f"export {k}='{safe}'")


if __name__ == "__main__":
    main()
