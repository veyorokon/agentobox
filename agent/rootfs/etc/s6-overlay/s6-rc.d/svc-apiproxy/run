#!/command/with-contenv bash
exec 2>&1
source /etc/s6-overlay/scripts/preflight

# OAuth mode: no proxy key, no proxy needed.
preflight --service svc-apiproxy --file /run/secrets/proxy_key

[ -f /home/agent/.relay_env ] && source /home/agent/.relay_env

exec abox-exec --service svc-apiproxy -- python3 /opt/abox/api-proxy.py
