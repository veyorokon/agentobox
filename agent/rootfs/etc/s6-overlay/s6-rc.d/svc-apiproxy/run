#!/command/with-contenv bash
exec 2>&1

# OAuth mode: no proxy key, no proxy needed — CC authenticates directly.
# Sleep forever so s6 doesn't restart-loop this service.
if [ ! -f /run/secrets/proxy_key ]; then
  echo "api-proxy: no proxy key found (OAuth mode) — skipping"
  exec sleep infinity
fi

# Source relay env for PROXY_* vars (auth header, upstream config).
# api-proxy needs these to know how to forward requests.
[ -f /home/agent/.relay_env ] && source /home/agent/.relay_env

exec python3 /opt/abox/api-proxy.py
