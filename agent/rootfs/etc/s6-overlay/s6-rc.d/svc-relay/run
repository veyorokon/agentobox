#!/command/with-contenv bash
exec 2>&1

# .relay_env is available via volume symlink (init-volume runs first).
# No polling needed — s6-rc dependency ensures init-volume completes first.

source /home/agent/.relay_env

# Reset crash counter
rm -f /tmp/svc-relay-crashes

WORK_DIR="/home/agent/workspace"
[ -d "$WORK_DIR" ] && cd "$WORK_DIR" || cd /home/agent

# s6-setuidgid drops privileges but does NOT update HOME
export HOME=/home/agent

exec s6-setuidgid agent python3 /opt/abox/relay.py
