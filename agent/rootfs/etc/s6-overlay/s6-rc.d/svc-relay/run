#!/command/with-contenv bash
exec 2>&1
source /etc/s6-overlay/scripts/preflight

[ -f /home/agent/.relay_env ] && source /home/agent/.relay_env

preflight --service svc-relay --env ABOX_CALLBACK_URL

# Reset crash counter
rm -f /tmp/svc-relay-crashes

WORK_DIR="/home/agent/workspace"
[ -d "$WORK_DIR" ] && cd "$WORK_DIR" || cd /home/agent

# s6-setuidgid drops privileges but does NOT update HOME
export HOME=/home/agent

exec s6-setuidgid agent abox-exec --service svc-relay -- python3 /opt/abox/relay.py
