#!/command/with-contenv bash
exec 2>&1
source /etc/s6-overlay/scripts/preflight

preflight --service svc-awesome --env DISPLAY

# Wait for Xvfb to be ready before starting
for i in $(seq 1 60); do
    xdpyinfo -display :1 >/dev/null 2>&1 && break
    sleep 0.5
done

export HOME=/home/agent
[ -f /run/dbus-session ] && . /run/dbus-session && export DBUS_SESSION_BUS_ADDRESS
xsetroot -cursor_name left_ptr 2>/dev/null
exec s6-setuidgid agent abox-exec --service svc-awesome -- awesome
