#!/command/with-contenv bash
exec 2>&1
source /etc/s6-overlay/scripts/preflight

preflight --service svc-x11vnc --env DISPLAY

# Wait for Xvfb to be ready before starting
for i in $(seq 1 60); do
    xdpyinfo -display :1 >/dev/null 2>&1 && break
    sleep 0.5
done

exec abox-exec --service svc-x11vnc -- x11vnc -display :1 -nopw -listen localhost -forever -shared -rfbport 5900 \
    -noxdamage -xfixes
