#!/bin/bash
# preflight — bash wrapper around /opt/abox/preflight.py.
#
# Usage in run scripts:
#   source /etc/s6-overlay/scripts/preflight
#   preflight --service svc-relay --env ABOX_CALLBACK_URL --file /home/agent/.relay_env
#
# On failure: emits structured JSON log and sleeps forever so s6 doesn't
# restart-loop the service. The service stays quiescent until the container
# is restarted with the missing config provided.

preflight() {
    # abox-exec wraps all output — if preflight.py is missing, the python
    # error gets structured automatically. No manual JSON needed here.
    if ! python3 /opt/abox/preflight.py "$@"; then
        exec sleep infinity
    fi
}
