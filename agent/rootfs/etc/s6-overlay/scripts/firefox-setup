#!/command/with-contenv bash
# Firefox profile setup — create default profile, inject textfox + Rose Pine Moon
UHOME=/home/agent
export HOME="$UHOME"
[ -f /run/dbus-session ] && . /run/dbus-session && export DBUS_SESSION_BUS_ADDRESS

# Firefox-ESR uses ~/.mozilla/firefox/ (not XDG ~/.config/mozilla/firefox/)
FF_DIR="$UHOME/.mozilla/firefox"

# Brief headless launch as agent to create default profile
s6-setuidgid agent /usr/bin/firefox-esr --headless &
FF_PID=$!
for i in $(seq 1 30); do
    FF_ACTIVE=$(find "$FF_DIR" -maxdepth 2 -name 'prefs.js' 2>/dev/null | head -1)
    [ -n "$FF_ACTIVE" ] && break
    sleep 0.5
done
kill $FF_PID 2>/dev/null
wait $FF_PID 2>/dev/null

if [ -n "$FF_ACTIVE" ]; then
    FF_TARGET=$(dirname "$FF_ACTIVE")
    cp -r /opt/textfox/chrome "$FF_TARGET/"
    cp /opt/textfox/user.js "$FF_TARGET/user.js"
    cp "$UHOME/.firefox-config/config.css" "$FF_TARGET/chrome/config.css"
    cat "$UHOME/.firefox-config/user-overrides.js" >> "$FF_TARGET/user.js"

    # Write default theme CSS so @import in config.css doesn't 404 on first boot.
    # Relay overwrites this with real theme tokens on WS connect.
    cat > /tmp/abox-theme.css << 'CSSEOF'
/* Default neutral theme — overwritten by relay on WS connect */
:root {
  --lwt-accent-color: #1e1e1e !important;
  --lwt-text-color: #d4d4d4 !important;
  --toolbar-bgcolor: #1e1e1e !important;
  --toolbar-color: #888888 !important;
  --toolbar-field-background-color: #1e1e1e !important;
  --toolbar-field-color: #d4d4d4 !important;
  --toolbar-field-border-color: #2d2d2d !important;
  --arrowpanel-background: #1e1e1e !important;
  --arrowpanel-color: #d4d4d4 !important;
  --arrowpanel-border-color: #2d2d2d !important;
  --newtab-background-color: #1e1e1e !important;
  --newtab-text-primary-color: #d4d4d4 !important;
  --tf-bg: #1e1e1e !important;
  --tf-border: #2d2d2d !important;
  --tf-accent: #5a5a5a !important;
}
CSSEOF
    chown agent:agent /tmp/abox-theme.css

    chown -R agent:agent "$FF_TARGET"
    echo "[agentobox] textfox + theme CSS injected into $(basename "$FF_TARGET")"
else
    echo "[agentobox] WARNING: Firefox profile not detected, textfox not applied"
fi
