#!/command/with-contenv bash
# Firefox profile setup — create default profile, inject textfox + Rose Pine Moon
UHOME=/home/agent
export HOME="$UHOME"
[ -f /run/dbus-session ] && . /run/dbus-session && export DBUS_SESSION_BUS_ADDRESS

# Firefox-ESR uses ~/.mozilla/firefox/ (not XDG ~/.config/mozilla/firefox/)
FF_DIR="$UHOME/.mozilla/firefox"

# Brief headless launch as agent to create default profile
s6-setuidgid agent /usr/bin/firefox-esr --headless &
FF_PID=$!
for i in $(seq 1 30); do
    FF_ACTIVE=$(find "$FF_DIR" -maxdepth 2 -name 'prefs.js' 2>/dev/null | head -1)
    [ -n "$FF_ACTIVE" ] && break
    sleep 0.5
done
kill $FF_PID 2>/dev/null
wait $FF_PID 2>/dev/null

if [ -n "$FF_ACTIVE" ]; then
    FF_TARGET=$(dirname "$FF_ACTIVE")
    cp -r /opt/textfox/chrome "$FF_TARGET/"
    cp /opt/textfox/user.js "$FF_TARGET/user.js"
    cp "$UHOME/.firefox-config/config.css" "$FF_TARGET/chrome/config.css"
    cat "$UHOME/.firefox-config/user-overrides.js" >> "$FF_TARGET/user.js"

    # Theme CSS is provided by the volume at /tmp/abox-theme/userChrome.css
    # (symlinked from /vol/agents/$AGENT_ID/tmp/abox-theme/ by init-volume).
    # No default CSS write needed — init-volume runs converters.py on boot.

    chown -R agent:agent "$FF_TARGET"
    echo "[agentobox] textfox + theme CSS injected into $(basename "$FF_TARGET")"
else
    echo "[agentobox] WARNING: Firefox profile not detected, textfox not applied"
fi
