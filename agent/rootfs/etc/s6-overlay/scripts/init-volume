#!/bin/bash
# init-volume — create symlinks from the agent's volume subdir into the container.
#
# Each agent gets its own subdir within the shared project volume:
#   /vol/agents/$AGENT_ID/home/agent/.claude  →  /home/agent/.claude
#   /vol/agents/$AGENT_ID/tmp/abox-theme      →  /tmp/abox-theme
#   etc.
#
# AGENT_ID is set as a container env var by _build_agent_env() in lifecycle.py.
# The volume root is /vol/ (Docker named volume mounted by _build_volume_mounts()).

AGENT_VOL="/vol/agents/${AGENT_ID}"

# Wait for backend to create _abox/ — the readiness handshake.
# Backend calls vol.initialize() during provisioning which creates this dir.
# All s6 services depend on init-volume, so nothing starts until this gate passes.
while [ ! -d "${AGENT_VOL}/_abox" ]; do sleep 0.5; done

# Fix ownership — backend creates volume files as root, but relay and
# Claude Code run as uid 1000 (agent). Chown the entire agent subdir
# so all services can read/write freely. This runs once at boot before
# any s6 service starts, so there's no race.
chown -R agent:agent "${AGENT_VOL}"

# Create symlinks: mirror volume structure into container filesystem.
# Top-level directories that map 1:1 to container paths:
for dir in tmp/abox-theme run/secrets run/mcp-gateway mnt/abox-state; do
    [ -e "${AGENT_VOL}/${dir}" ] && ln -sfn "${AGENT_VOL}/${dir}" "/${dir}"
done

# Everything in /home/agent/ — files and dirs (workspace, .claude, .mcp.json, etc.)
for entry in "${AGENT_VOL}"/home/agent/*  "${AGENT_VOL}"/home/agent/.*; do
    name="$(basename "$entry")"
    [ "$name" = "." ] || [ "$name" = ".." ] && continue
    [ -e "$entry" ] && ln -sfn "$entry" "/home/agent/${name}"
done

# /opt/abox/ files (api-key-helper.sh, etc.)
for entry in "${AGENT_VOL}"/opt/abox/*; do
    name="$(basename "$entry")"
    [ -e "$entry" ] && ln -sfn "$entry" "/opt/abox/${name}"
done

# Run theme converter on initial tokens if present
if [ -f "${AGENT_VOL}/tmp/abox-theme/tokens.json" ]; then
    python3 /opt/abox/converters.py "${AGENT_VOL}/tmp/abox-theme/tokens.json"
fi

# Ensure secrets are sourced on login
grep -q 'abox-state/secrets/env' /home/agent/.bashrc 2>/dev/null \
    || echo 'source /mnt/abox-state/secrets/env 2>/dev/null' >> /home/agent/.bashrc
