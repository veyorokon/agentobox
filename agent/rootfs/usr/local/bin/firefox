#!/bin/bash
# Firefox wrapper — if Firefox is already running, navigate within it
# instead of launching a second instance (which hits the profile lock).

# Extract the first non-flag argument as a URL
URL=""
for arg in "$@"; do
    case "$arg" in
        -*) ;;
        *) URL="$arg"; break ;;
    esac
done

if pgrep -x firefox-esr >/dev/null 2>&1; then
    if [ -n "$URL" ]; then
        # Firefox is running — navigate current tab to the URL
        xdotool search --name "Mozilla Firefox" windowactivate --sync 2>/dev/null
        xdotool key --clearmodifiers ctrl+l
        sleep 0.1
        xdotool type --clearmodifiers -- "$URL"
        xdotool key --clearmodifiers Return
    else
        # No URL — just focus the existing window
        xdotool search --name "Mozilla Firefox" windowactivate 2>/dev/null
    fi
    exit 0
fi

# No running instance — launch normally
[ -f /run/dbus-session ] && . /run/dbus-session && export DBUS_SESSION_BUS_ADDRESS
exec /usr/bin/firefox-esr "$@"
