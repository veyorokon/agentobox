{
  "description": "Agentobox agent hooks",
  "hooks": {
    "SessionStart": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
    "SessionEnd": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
    "Stop": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
    "TaskCompleted": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
    "SubagentStart": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
    "SubagentStop": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
    "TeammateIdle": [{"matcher": "*", "hooks": [{"type": "command", "command": "bash /home/computeruse/hooks/hook-event.sh"}]}],
