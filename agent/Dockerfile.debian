# ── Base layer (generic, any agent type) ──
# s6-overlay, system packages, Xvfb/VNC/noVNC, AwesomeWM, Node.js,
# GitHub CLI, Firefox, fonts, user setup, rootfs overlay, env vars
#
# ── Claude Code layer (agent-type-specific) ──
# Lines 33-35: Python websockets + claude-agent-sdk
# Lines 75-77: Claude Code CLI (npm install -g @anthropic-ai/claude-code)
# Lines 79-89: Computer Use MCP server
#
# When adding a second agent type, split this file:
#   Dockerfile.base  — everything above
#   Dockerfile.claude — FROM agentobox-base, adds CC-specific deps
#   Dockerfile.codex  — FROM agentobox-base, adds Codex-specific deps
# Each adapter dir can own an image/ subdir with its Dockerfile + relay.

FROM debian:bookworm-slim

ARG S6_OVERLAY_VERSION=3.2.2.0
ARG TARGETARCH

# --- s6-overlay ---
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp
RUN apt-get update && apt-get install -y --no-install-recommends wget xz-utils ca-certificates \
    && tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz && rm /tmp/s6-overlay-noarch.tar.xz \
    && S6_ARCH=$(case "$TARGETARCH" in arm64) echo aarch64;; *) echo x86_64;; esac) \
    && wget -qO /tmp/s6-overlay-arch.tar.xz \
       "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${S6_ARCH}.tar.xz" \
    && tar -C / -Jxpf /tmp/s6-overlay-arch.tar.xz && rm /tmp/s6-overlay-arch.tar.xz \
    && apt-get purge -y wget xz-utils && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# --- System packages ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl jq git sudo openssl fontconfig unzip tmux \
    xvfb x11vnc xterm xdotool \
    awesome dbus dbus-x11 \
    python3-websockify \
    dmz-cursor-theme \
    && dbus-uuidgen > /etc/machine-id \
    && rm -rf /var/lib/apt/lists/*

# --- Python websockets (relay WS transport) ---
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip \
    && pip3 install --break-system-packages websockets==15.0.1 claude-agent-sdk==0.1.39 \
    && apt-get purge -y python3-pip && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# --- Node.js ---
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- GitHub CLI ---
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# --- Firefox ESR ---
RUN apt-get update && apt-get install -y --no-install-recommends firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# --- JetBrains Mono (not in bookworm repos) ---
RUN mkdir -p /usr/share/fonts/truetype/jetbrains-mono \
    && curl -fsSL https://github.com/JetBrains/JetBrainsMono/releases/download/v2.304/JetBrainsMono-2.304.zip \
       -o /tmp/jbmono.zip \
    && unzip -q /tmp/jbmono.zip -d /tmp/jbmono \
    && cp /tmp/jbmono/fonts/ttf/*.ttf /usr/share/fonts/truetype/jetbrains-mono/ \
    && fc-cache -f \
    && rm -rf /tmp/jbmono /tmp/jbmono.zip

# --- noVNC (web client only, websockify via apt) ---
RUN git clone --depth 1 --branch v1.6.0 https://github.com/novnc/noVNC.git /opt/noVNC \
    && ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html \
    && rm -rf /opt/noVNC/.git

# --- textfox ---
ARG TEXTFOX_COMMIT=e86c0a3a77cbdd8dbbca51b0c190733c8e6788e1
RUN git clone https://github.com/adriankarlen/textfox.git /opt/textfox \
    && cd /opt/textfox && git checkout ${TEXTFOX_COMMIT} \
    && rm -rf /opt/textfox/.git

# --- Claude Code CLI ---
ARG CLAUDE_CODE_VERSION=2.1.59
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && npm cache clean --force

# --- Computer Use MCP server ---
COPY mcp-servers/computer-use/package.json mcp-servers/computer-use/package-lock.json /opt/mcp-servers/computer-use/
COPY mcp-servers/computer-use/dist/ /opt/mcp-servers/computer-use/dist/
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make g++ libx11-dev libxtst-dev libxinerama-dev libpng-dev libvips-dev \
    && cd /opt/mcp-servers/computer-use \
    && (npm ci --omit=dev 2>/dev/null || npm install --omit=dev) \
    && npm cache clean --force \
    && apt-get purge -y make g++ libx11-dev libxtst-dev libxinerama-dev libpng-dev libvips-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# --- User ---
# Scoped sudo: package management only. No blanket NOPASSWD:ALL.
# _provision_scoped_sudo in provision.py writes the same rule at runtime
# as a defensive measure, but baking it here eliminates the race window
# between container start and provisioning.
RUN useradd -m -s /bin/bash agent \
    && echo "# Agentobox: scoped sudo for agent container" > /etc/sudoers.d/agentobox \
    && echo "# Allows package management only — blocks reading secrets via sudo" >> /etc/sudoers.d/agentobox \
    && echo "agent ALL=(ALL) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt, /usr/bin/dpkg" >> /etc/sudoers.d/agentobox \
    && chmod 0440 /etc/sudoers.d/agentobox

# --- Filesystem overlay (configs + s6 services) ---
COPY rootfs/ /
RUN chmod +x /etc/s6-overlay/scripts/* \
    && chmod +x /etc/s6-overlay/s6-rc.d/*/run /etc/s6-overlay/s6-rc.d/*/finish 2>/dev/null || true \
    && chmod +x /opt/abox/relay.py \
    && chmod +x /opt/abox/api-proxy.py \
    && chmod +x /opt/abox/theme-bridge.py \
    && chmod +x /opt/abox/hooks/*.py \
    && chmod +x /usr/local/bin/firefox /usr/local/bin/firefox-esr \
    && python3 -c "import zipfile; z = zipfile.ZipFile('/opt/abox/firefox-theme.xpi', 'w'); z.write('/opt/abox/firefox-theme/manifest.json', 'manifest.json'); z.write('/opt/abox/firefox-theme/background.js', 'background.js'); z.close()" \
    && chown -R agent:agent /home/agent

# --- Environment ---
ENV DISPLAY=:1
ENV RESOLUTION=1920x1080
ENV S6_KEEP_ENV=1
ENV S6_LOGGING=1
ENV XCURSOR_THEME=DMZ-White
ENV XCURSOR_SIZE=24

EXPOSE 6080

ENTRYPOINT ["/init"]
