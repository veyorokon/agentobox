{
  "name": "agentobox-server",
  "version": "0.1.0",
  "description": "Agentobox control plane server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "npm run build && node --import ./dist/instrumentation.js dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@hono/node-server": "^1.14.1",
    "@hono/otel": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "better-sqlite3": "^12.6.2",
    "braintrust": "^2.2.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.6",
    "pino": "^10.3.0",
    "pino-opentelemetry-transport": "^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/pino": "^7.0.4",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
